[Unit]
Description=Shared Chromium for Autovisor (CDP :9222)
After=xvfb.service network.target
Requires=xvfb.service

[Service]
Environment=DISPLAY=:99
ExecStart=/opt/Nlauto/venv/bin/python -c "from playwright.sync_api import sync_playwright; p=sync_playwright().start(); b=p.chromium.launch(headless=False,args=['--no-sandbox','--start-maximized','--window-size=1920,1080','--remote-debugging-port=9222','--remote-allow-origins=*','--disable-gpu','--disable-dev-shm-usage']); print('Chromium ready on :9222'); b.wait_for_event('close',timeout=0)"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

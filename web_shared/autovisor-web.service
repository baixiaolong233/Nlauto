[Unit]
Description=Autovisor Web Service
After=xvfb.service network.target
Requires=xvfb.service

[Service]
WorkingDirectory=/opt/Auto/web
Environment=DISPLAY=:99
Environment=MAX_CONCURRENT=1
Environment=SECRET_KEY=autovisor-prod-7f3a9c2e1b8d
ExecStart=/opt/Auto/venv/bin/python app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
